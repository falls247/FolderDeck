<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Color tokens transcribed from imgtool styles.css (spec §15.2). -->
    <Color x:Key="Color.Bg">#f4f5f7</Color>
    <Color x:Key="Color.Surface">#ffffff</Color>
    <Color x:Key="Color.Surface2">#f1f3f6</Color>
    <Color x:Key="Color.Surface3">#e7eaef</Color>
    <Color x:Key="Color.Border">#dde1e7</Color>
    <Color x:Key="Color.BorderStrong">#c7cdd6</Color>
    <Color x:Key="Color.Text">#1c2230</Color>
    <Color x:Key="Color.Muted">#667085</Color>
    <Color x:Key="Color.Accent">#2563eb</Color>
    <Color x:Key="Color.AccentHover">#1d4ed8</Color>
    <Color x:Key="Color.AccentSoft">#e3ecfd</Color>
    <Color x:Key="Color.Ok">#15803d</Color>
    <Color x:Key="Color.OkSoft">#e1f4e7</Color>
    <Color x:Key="Color.Warn">#b45309</Color>
    <Color x:Key="Color.WarnSoft">#fdf0dc</Color>
    <Color x:Key="Color.Danger">#dc2626</Color>
    <Color x:Key="Color.DangerSoft">#fde6e6</Color>
    <Color x:Key="Color.CardShadow">#14101828</Color>
    <Color x:Key="Color.OnAccent">#ffffff</Color>
    <SolidColorBrush x:Key="Brush.Bg" Color="{StaticResource Color.Bg}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.Surface2" Color="{StaticResource Color.Surface2}" />
    <SolidColorBrush x:Key="Brush.Surface3" Color="{StaticResource Color.Surface3}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource Color.BorderStrong}" />
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="Brush.Muted" Color="{StaticResource Color.Muted}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="{StaticResource Color.AccentSoft}" />
    <SolidColorBrush x:Key="Brush.Ok" Color="{StaticResource Color.Ok}" />
    <SolidColorBrush x:Key="Brush.OkSoft" Color="{StaticResource Color.OkSoft}" />
    <SolidColorBrush x:Key="Brush.Warn" Color="{StaticResource Color.Warn}" />
    <SolidColorBrush x:Key="Brush.WarnSoft" Color="{StaticResource Color.WarnSoft}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="{StaticResource Color.DangerSoft}" />
    <SolidColorBrush x:Key="Brush.CardShadow" Color="{StaticResource Color.CardShadow}" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="{StaticResource Color.OnAccent}" />
</ResourceDictionary>
