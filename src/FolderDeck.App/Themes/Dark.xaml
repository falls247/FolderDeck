<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Color tokens transcribed from imgtool styles.css (spec §15.2). -->
    <Color x:Key="Color.Bg">#101317</Color>
    <Color x:Key="Color.Surface">#181c22</Color>
    <Color x:Key="Color.Surface2">#20252d</Color>
    <Color x:Key="Color.Surface3">#2a3039</Color>
    <Color x:Key="Color.Border">#2c323c</Color>
    <Color x:Key="Color.BorderStrong">#3b4350</Color>
    <Color x:Key="Color.Text">#e5e8ee</Color>
    <Color x:Key="Color.Muted">#98a2b3</Color>
    <Color x:Key="Color.Accent">#4f8ef7</Color>
    <Color x:Key="Color.AccentHover">#6ba0f8</Color>
    <Color x:Key="Color.AccentSoft">#1c2b47</Color>
    <Color x:Key="Color.Ok">#4ade80</Color>
    <Color x:Key="Color.OkSoft">#14301f</Color>
    <Color x:Key="Color.Warn">#fbbf24</Color>
    <Color x:Key="Color.WarnSoft">#3a2c0d</Color>
    <Color x:Key="Color.Danger">#f87171</Color>
    <Color x:Key="Color.DangerSoft">#3d1717</Color>
    <Color x:Key="Color.CardShadow">#40000000</Color>
    <Color x:Key="Color.OnAccent">#ffffff</Color>
    <!-- 登録フォルダ and the folder tabs opened from them (the fixed tabs use Accent) -->
    <Color x:Key="Color.Folder">#2dd4bf</Color>
    <Color x:Key="Color.FolderSoft">#123531</Color>
    <SolidColorBrush x:Key="Brush.Folder" Color="{StaticResource Color.Folder}" />
    <SolidColorBrush x:Key="Brush.FolderSoft" Color="{StaticResource Color.FolderSoft}" />
    <SolidColorBrush x:Key="Brush.Bg" Color="{StaticResource Color.Bg}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.Surface2" Color="{StaticResource Color.Surface2}" />
    <SolidColorBrush x:Key="Brush.Surface3" Color="{StaticResource Color.Surface3}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource Color.BorderStrong}" />
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="Brush.Muted" Color="{StaticResource Color.Muted}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="{StaticResource Color.AccentSoft}" />
    <SolidColorBrush x:Key="Brush.Ok" Color="{StaticResource Color.Ok}" />
    <SolidColorBrush x:Key="Brush.OkSoft" Color="{StaticResource Color.OkSoft}" />
    <SolidColorBrush x:Key="Brush.Warn" Color="{StaticResource Color.Warn}" />
    <SolidColorBrush x:Key="Brush.WarnSoft" Color="{StaticResource Color.WarnSoft}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="{StaticResource Color.DangerSoft}" />
    <!-- The panes of a split window and their tabs (MainViewModel.UpdatePaneSlots): the same colour on both. Soft: backgrounds; strong: the tab's line -->
    <SolidColorBrush x:Key="Brush.Pane0" Color="#1b2944" />
    <SolidColorBrush x:Key="Brush.Pane0Strong" Color="#6e9bf3" />
    <SolidColorBrush x:Key="Brush.Pane1" Color="#352a19" />
    <SolidColorBrush x:Key="Brush.Pane1Strong" Color="#e2a04a" />
    <SolidColorBrush x:Key="Brush.Pane2" Color="#1a3222" />
    <SolidColorBrush x:Key="Brush.Pane2Strong" Color="#5cc07b" />
    <SolidColorBrush x:Key="Brush.Pane3" Color="#30223a" />
    <SolidColorBrush x:Key="Brush.Pane3Strong" Color="#c88ae2" />
    <SolidColorBrush x:Key="Brush.CardShadow" Color="{StaticResource Color.CardShadow}" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="{StaticResource Color.OnAccent}" />
</ResourceDictionary>
