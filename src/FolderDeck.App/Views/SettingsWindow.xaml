<Window x:Class="FolderDeck.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定" SizeToContent="Height" Width="520" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Surface}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource Font.UI}" FontSize="13" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="Section" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
            <Setter Property="Margin" Value="0,16,0,8" />
        </Style>
        <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="22,8,22,16">
        <TextBlock Text="表示" Style="{StaticResource Section}" />
        <CheckBox Content="隠しファイルを表示" IsChecked="{Binding ShowHidden}" />
        <CheckBox Content="実行形式を開く前に確認する" IsChecked="{Binding ConfirmExecutables}" />

        <TextBlock Text="最近の履歴・よく使う項目" Style="{StaticResource Section}" />
        <CheckBox Content="Windows の最近使った項目を含める" IsChecked="{Binding IncludeWindowsRecent}" />
        <CheckBox Content="開いたファイルを Windows の最近使った項目にも追加する" IsChecked="{Binding AddToWindowsRecent}" />
        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="90" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="最近の履歴の表示件数（10〜500）" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Style="{StaticResource Input}" Text="{Binding RecentLimitText, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" />
            <TextBlock Grid.Row="1" Text="よく使う項目の表示件数（10〜200）" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource Input}" Text="{Binding FrequentLimitText, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" />
        </Grid>

        <TextBlock Text="エクスプローラー" Style="{StaticResource Section}" />
        <CheckBox IsChecked="{Binding OpenExplorerInNewTab}">
            <TextBlock Text="エクスプローラーで表示・開くとき、開いているエクスプローラーに新しいタブで開く（Windows 11）" TextWrapping="Wrap" />
        </CheckBox>
        <TextBlock Text="エクスプローラーが開いていないとき、またはタブに対応していない Windows では、新しいウィンドウで開きます。"
                   TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Brush.Muted}" Margin="20,0,0,0" />

        <TextBlock Text="データ" Style="{StaticResource Section}" />
        <WrapPanel>
            <Button Style="{StaticResource Btn}" Content="よく使う項目の統計をリセット" Command="{Binding ResetStatsCommand}" Margin="0,0,8,8" />
            <Button Style="{StaticResource Btn}" Content="データフォルダを開く" Command="{Binding OpenDataFolderCommand}" Margin="0,0,8,8" />
        </WrapPanel>
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Ok}" Margin="0,2,0,0" />
        <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Danger}" Margin="0,2,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource Btn.Primary}" Content="OK" MinWidth="100" Margin="0,0,8,0" IsDefault="True" Click="OnOk" />
            <Button Style="{StaticResource Btn}" Content="キャンセル" MinWidth="100" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
