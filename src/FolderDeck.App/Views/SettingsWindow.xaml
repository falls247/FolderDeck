<Window x:Class="FolderDeck.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FolderDeck.Views"
        Title="設定" SizeToContent="Height" Width="520" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Surface}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource Font.UI}" FontSize="13" UseLayoutRounding="True">
    <Window.Resources>
        <views:NotEmptyToVisibilityConverter x:Key="NotEmptyToVis" />
        <Style x:Key="Section" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
            <Setter Property="Margin" Value="0,16,0,8" />
        </Style>
        <Style x:Key="Help" TargetType="{x:Type TextBlock}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
        </Style>
        <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <!-- a tab of the settings: its name, underlined in the accent colour while shown -->
        <Style x:Key="PageTab" TargetType="{x:Type RadioButton}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
            <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,8,12,6" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing.Btn}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="Bd" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <!--
      The settings in tabs (表示 / 操作 / フォルダ / 履歴 / データ; Ctrl+Tab and Ctrl+PageDown switch).
      The pages lie on top of each other and those not shown are Hidden, not Collapsed: the window
      is as tall as the tallest page and does not jump when the tab changes. It is at most as tall as
      the main window (MainWindow.ShowSettings sets MaxHeight): the page scrolls above the message
      and the OK / キャンセル row, which always stay in view.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="14,6,14,0">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="TabView" Style="{StaticResource PageTab}" GroupName="Page" Content="表示" Checked="OnTabChecked"
                             ToolTip="テーマ（配色）・文字の大きさ" />
                <RadioButton x:Name="TabActions" Style="{StaticResource PageTab}" GroupName="Page" Content="操作" Checked="OnTabChecked"
                             ToolTip="開き方・右クリックのメニュー・エクスプローラー" />
                <RadioButton x:Name="TabFolders" Style="{StaticResource PageTab}" GroupName="Page" Content="フォルダ" Checked="OnTabChecked"
                             ToolTip="隠しファイル・フォルダの自動更新" />
                <RadioButton x:Name="TabHistory" Style="{StaticResource PageTab}" GroupName="Page" Content="履歴" Checked="OnTabChecked"
                             ToolTip="最近の履歴・よく使う項目" />
                <RadioButton x:Name="TabData" Style="{StaticResource PageTab}" GroupName="Page" Content="データ" Checked="OnTabChecked"
                             ToolTip="サムネイルのキャッシュ・データフォルダ" />
            </StackPanel>
        </Border>

        <ScrollViewer x:Name="PageScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <Grid Margin="22,0,22,0">
                <!-- 表示 -->
                <StackPanel x:Name="PageView">
                    <TextBlock Text="テーマ（配色）" Style="{StaticResource Section}" />
                    <Border HorizontalAlignment="Left" CornerRadius="8" Padding="3" Background="{DynamicResource Brush.Surface2}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Toggle.Choice}" GroupName="Theme" Content="システム" IsChecked="{Binding IsThemeSystem}"
                                         ToolTip="Windows の設定（アプリのモード：ライト／ダーク）に合わせます" />
                            <RadioButton Style="{StaticResource Toggle.Choice}" GroupName="Theme" Content="ライト" IsChecked="{Binding IsThemeLight}" Margin="3,0,0,0" />
                            <RadioButton Style="{StaticResource Toggle.Choice}" GroupName="Theme" Content="ダーク" IsChecked="{Binding IsThemeDark}" Margin="3,0,0,0" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="「システム」は Windows の設定（アプリのモード）に合わせます。OK を押すと切り替わります。"
                               Style="{StaticResource Help}" Margin="0,6,0,0" />

                    <TextBlock Text="文字の大きさ" Style="{StaticResource Section}" />
                    <!-- one switch per step (SettingsViewModel.TextScaleChoices); the padding on the right is the last switch's margin -->
                    <Border HorizontalAlignment="Left" CornerRadius="8" Padding="3,3,0,3" Background="{DynamicResource Brush.Surface2}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                        <ItemsControl ItemsSource="{Binding TextScaleChoices}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Style="{StaticResource Toggle.Choice}" GroupName="TextScale" MinWidth="56" Margin="0,0,3,0"
                                                 Content="{Binding Label}" IsChecked="{Binding IsSelected}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <TextBlock Text="サイドバー・カード・詳細表示・中身の一覧（オーバーレイ・フライアウト）の文字を大きくします（タブ・ツールバー・メニュー・プレビューは変わりません）。OK を押すと切り替わります。"
                               Style="{StaticResource Help}" Margin="0,6,0,0" />
                </StackPanel>

                <!-- 操作 -->
                <StackPanel x:Name="PageActions" Visibility="Hidden">
                    <TextBlock Text="開き方" Style="{StaticResource Section}" />
                    <CheckBox Content="ダブルクリックで開く" IsChecked="{Binding OpenOnDoubleClick}" />
                    <TextBlock Text="オンにすると、カード・詳細表示の行は 1 回のクリックでその項目だけを選び、ダブルクリックで開きます（サイドバーと一覧の行は 1 回のクリックのまま）。"
                               Style="{StaticResource Help}" Margin="20,0,0,0" />
                    <CheckBox Content="実行形式を開く前に確認する" IsChecked="{Binding ConfirmExecutables}" />
                    <TextBlock Text="「ダブルクリックで開く」がオンのときは、カード・詳細表示の行のダブルクリックでは確認しません（Enter、右クリックの「開く」、中身の一覧・プレビューのクリック、アドレス欄では確認します）。"
                               Style="{StaticResource Help}" Margin="20,0,0,0" />

                    <TextBlock Text="右クリックのメニュー" Style="{StaticResource Section}" />
                    <Border HorizontalAlignment="Left" CornerRadius="8" Padding="3" Background="{DynamicResource Brush.Surface2}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Toggle.Choice}" GroupName="ItemMenu" Content="アプリのメニュー" IsChecked="{Binding IsItemMenuApp}" />
                            <RadioButton Style="{StaticResource Toggle.Choice}" GroupName="ItemMenu" Content="Windows のメニュー" IsChecked="{Binding IsItemMenuWindows}" Margin="3,0,0,0" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="「Windows のメニュー」は、項目と一覧の空いているところの右クリックでエクスプローラーのメニュー（7-Zip・送る・プロパティ、空いているところでは新規作成など）を出し、その上にアプリの項目を並べます。ドライブ・表示中のフォルダがない空いているところ・使えない項目や、エクスプローラーのメニューが 5 秒以内に準備できなかったときは、アプリのメニューを出します（準備できなかった項目は、しばらくアプリのメニューになります）。"
                               Style="{StaticResource Help}" Margin="0,6,0,0" />

                    <TextBlock Text="メッセージの表示" Style="{StaticResource Section}" />
                    <Border HorizontalAlignment="Left" CornerRadius="8" Padding="3" Background="{DynamicResource Brush.Surface2}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Toggle.Choice}" GroupName="MessagePlacement" Content="上（アドレス欄の下）" IsChecked="{Binding IsMessageTop}" />
                            <RadioButton Style="{StaticResource Toggle.Choice}" GroupName="MessagePlacement" Content="下（一覧の下）" IsChecked="{Binding IsMessageBottom}" Margin="3,0,0,0" />
                            <RadioButton Style="{StaticResource Toggle.Choice}" GroupName="MessagePlacement" Content="表示しない" IsChecked="{Binding IsMessageOff}" Margin="3,0,0,0" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="「～を開きました」「パスをコピーしました」などの操作のメッセージを出す場所です。「表示しない」で出さなくなるのは、操作できたことを知らせるメッセージだけです。操作できなかった理由（見つからない・〜できない・前の操作の途中など）、警告、エラーは上に出します。OK を押すとすぐ切り替わります。"
                               Style="{StaticResource Help}" Margin="0,6,0,0" />

                    <TextBlock Text="エクスプローラー" Style="{StaticResource Section}" />
                    <CheckBox IsChecked="{Binding OpenExplorerInNewTab}">
                        <TextBlock Text="エクスプローラーで表示するとき、開いているエクスプローラーに新しいタブで開く（Windows 11）" TextWrapping="Wrap" />
                    </CheckBox>
                    <TextBlock Text="エクスプローラーが開いていないとき、またはタブに対応していない Windows では、新しいウィンドウで開きます。"
                               Style="{StaticResource Help}" Margin="20,0,0,0" />
                </StackPanel>

                <!-- フォルダ -->
                <StackPanel x:Name="PageFolders" Visibility="Hidden">
                    <TextBlock Text="表示する項目" Style="{StaticResource Section}" />
                    <CheckBox Content="隠しファイルを表示" IsChecked="{Binding ShowHidden}" />

                    <TextBlock Text="フォルダの自動更新" Style="{StaticResource Section}" />
                    <Border HorizontalAlignment="Left" CornerRadius="8" Padding="3" Background="{DynamicResource Brush.Surface2}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Toggle.Choice}" GroupName="AutoRefresh" Content="自動更新なし" IsChecked="{Binding IsAutoRefreshOff}" />
                            <RadioButton Style="{StaticResource Toggle.Choice}" GroupName="AutoRefresh" Content="一定の間隔で更新" IsChecked="{Binding IsAutoRefreshInterval}" Margin="3,0,0,0" />
                        </StackPanel>
                    </Border>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="更新の間隔（秒、2〜3600）" VerticalAlignment="Center" />
                        <TextBox x:Name="IntervalBox" InputMethod.IsInputMethodEnabled="False" Grid.Column="1" Style="{StaticResource Input}" Text="{Binding AutoRefreshSecondsText, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsAutoRefreshInterval}" Margin="0,3" />
                    </Grid>
                    <TextBlock Text="表示中のフォルダを指定の間隔で確認し、ファイルの追加・削除・名前の変更・書き換えがあれば一覧を更新します（選択とスクロール位置は残ります）。名前・アドレスの入力中、メニュー・オーバーレイ・ダイアログの表示中、ドラッグ中、操作の直後、最小化中は待ちます。応答のないフォルダは間隔を延ばし、一覧は消しません。"
                               Style="{StaticResource Help}" Margin="0,6,0,0" />
                </StackPanel>

                <!-- 履歴 -->
                <StackPanel x:Name="PageHistory" Visibility="Hidden">
                    <TextBlock Text="最近の履歴・よく使う項目" Style="{StaticResource Section}" />
                    <CheckBox Content="Windows の最近使った項目を含める" IsChecked="{Binding IncludeWindowsRecent}" />
                    <CheckBox Content="開いたファイルを Windows の最近使った項目にも追加する" IsChecked="{Binding AddToWindowsRecent}" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="最近の履歴の表示件数（10〜500）" VerticalAlignment="Center" />
                        <TextBox x:Name="RecentBox" InputMethod.IsInputMethodEnabled="False" Grid.Column="1" Style="{StaticResource Input}" Text="{Binding RecentLimitText, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" />
                        <TextBlock Grid.Row="1" Text="よく使う項目の表示件数（10〜200）" VerticalAlignment="Center" />
                        <TextBox x:Name="FrequentBox" InputMethod.IsInputMethodEnabled="False" Grid.Row="1" Grid.Column="1" Style="{StaticResource Input}" Text="{Binding FrequentLimitText, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" />
                    </Grid>

                    <TextBlock Text="統計" Style="{StaticResource Section}" />
                    <Button Style="{StaticResource Btn}" Content="よく使う項目の統計をリセット" Command="{Binding ResetStatsCommand}" HorizontalAlignment="Left" />
                    <TextBlock Text="確認のうえ、アプリの利用記録（開いた回数・日時）をすべて消します。最近の履歴からも、このアプリで開いた項目が消えます（Windows の最近使った項目は残ります）。ピン留めは残り、ファイルは消しません。"
                               Style="{StaticResource Help}" Margin="0,6,0,0" />
                </StackPanel>

                <!-- データ -->
                <StackPanel x:Name="PageData" Visibility="Hidden">
                    <TextBlock Text="画像サムネイルのキャッシュ" Style="{StaticResource Section}" />
                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="キャッシュの上限（MB、0〜8192。0 で保存しない）" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <TextBox x:Name="CacheBox" InputMethod.IsInputMethodEnabled="False" Grid.Column="1" Style="{StaticResource Input}" Text="{Binding ThumbCacheMbText, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" />
                    </Grid>
                    <TextBlock Text="一度表示した画像のサムネイルをデータフォルダの thumbs に保存し、次からすぐ表示します。変更は次回の起動から有効です。"
                               Style="{StaticResource Help}" />

                    <TextBlock Text="データフォルダ" Style="{StaticResource Section}" />
                    <Button Style="{StaticResource Btn}" Content="データフォルダを開く" Command="{Binding OpenDataFolderCommand}" HorizontalAlignment="Left" />
                    <TextBlock Text="設定・登録フォルダ・履歴・ログ・サムネイルのキャッシュを置いているフォルダを、エクスプローラーで開きます。"
                               Style="{StaticResource Help}" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- the message (an invalid field, a reset) stays in view whichever tab is shown -->
        <Grid Grid.Row="2" Margin="22,16,22,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Ok}"
                           Visibility="{Binding Status, Converter={StaticResource NotEmptyToVis}}" />
                <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Danger}"
                           Visibility="{Binding Error, Converter={StaticResource NotEmptyToVis}}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Style="{StaticResource Btn.Primary}" Content="OK" MinWidth="100" Margin="0,0,8,0" IsDefault="True" Click="OnOk" />
                <Button Style="{StaticResource Btn}" Content="キャンセル" MinWidth="100" IsCancel="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
