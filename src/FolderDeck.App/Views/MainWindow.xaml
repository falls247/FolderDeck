<Window x:Class="FolderDeck.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FolderDeck.Views"
        xmlns:vm="clr-namespace:FolderDeck.ViewModels"
        xmlns:layout="clr-namespace:FolderDeck.Core.Layout;assembly=FolderDeck.Core"
        Title="FolderDeck" Width="1280" Height="800" MinWidth="992" MinHeight="420"
        Background="{DynamicResource Brush.Bg}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource Font.UI}" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True" AllowDrop="True"
        Icon="pack://application:,,,/FolderDeck;component/Assets/FolderDeck.ico">
    <Window.Resources>
        <views:EnumEqualsConverter x:Key="EnumEquals" />
        <views:NotEmptyToVisibilityConverter x:Key="NotEmptyToVis" />
        <views:InverseBoolConverter x:Key="Not" />

        <Style x:Key="MessageBar" TargetType="{x:Type Border}">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="16,8,16,0" />
            <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Accent}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Message.Kind}" Value="{x:Static vm:MessageKind.Success}">
                    <Setter Property="Background" Value="{DynamicResource Brush.OkSoft}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Ok}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Message.Kind}" Value="{x:Static vm:MessageKind.Warning}">
                    <Setter Property="Background" Value="{DynamicResource Brush.WarnSoft}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Warn}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Message.Kind}" Value="{x:Static vm:MessageKind.Error}">
                    <Setter Property="Background" Value="{DynamicResource Brush.DangerSoft}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Danger}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
      <Grid.ColumnDefinitions>
          <!-- the width is set from settings.json in code (sidebar_width; 0 while the sidebar is hidden) and changed with the splitter -->
          <ColumnDefinition x:Name="SidebarColumn" Width="220" MinWidth="140" MaxWidth="480" />
          <ColumnDefinition Width="Auto" />
          <!-- 724: the toolbar of 最近の履歴 (count, clear, filter, sort, view mode, size, refresh) without clipping -->
          <ColumnDefinition Width="*" MinWidth="724" />
      </Grid.ColumnDefinitions>

      <!-- Sidebar (§10.1): its sections live in SidebarView. Hidden as a whole with the toggle at the
           left end of the tab row (ApplySidebarLayout). -->
      <Border x:Name="SidebarPane" Grid.Column="0" Background="{DynamicResource Brush.Surface}">
          <Grid>
              <views:SidebarView x:Name="Sidebar" />

              <!-- drop hint while dragging over the window: what a release does there (registration, or a move / copy
                   into the folder under the pointer). A band at the top, over クイック アクセス, so that the 登録フォルダ
                   and drive rows (drop targets) stay visible. -->
              <Border x:Name="DropHint" Margin="6" CornerRadius="10" BorderThickness="2" BorderBrush="{DynamicResource Brush.Folder}"
                      Background="{DynamicResource Brush.FolderSoft}" Opacity="0.94" Visibility="Collapsed" IsHitTestVisible="False"
                      VerticalAlignment="Top">
                  <TextBlock x:Name="DropHintText" Text="ドロップして登録" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Folder}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="8" />
              </Border>
          </Grid>
      </Border>

      <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                    ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" Focusable="False" Cursor="SizeWE"
                    Background="{DynamicResource Brush.Border}" ToolTip="ドラッグでサイドメニューの幅を変更"
                    DragStarted="OnSplitterDragStarted" DragCompleted="OnSplitterDragCompleted" />

      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Sidebar toggle + tabs + settings (§5.1): one strip for every open tab (the row keeps its height without any tab) -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <DockPanel Margin="8,0,8,0" MinHeight="38">
                <Button DockPanel.Dock="Left" Style="{StaticResource Btn.Icon}" Content="&#xE90C;" ToolTip="サイドメニューを表示 / 隠す"
                        Command="{Binding ToggleSidebarCommand}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Content="&#xE713;" ToolTip="設定"
                        Command="{Binding OpenSettingsCommand}" VerticalAlignment="Center" />
                <views:FolderTabStrip x:Name="TabStrip" />
            </DockPanel>
        </Border>

        <!-- Toolbar (§5.3): only while a tab is shown -->
        <Border Grid.Row="1" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                Padding="8,6" Visibility="{Binding HasTab, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource Btn.Icon}" Content="&#xE74A;" ToolTip="{views:ShortcutTip Text=1つ上へ, Id=Up}"
                        Command="{Binding GoUpCommand}" />

                <!--
                  Address bar: the shown folder's whole path, a crumb per folder (E:\ 仕事 \ 案件; a
                  fixed tab's list first). A crumb goes to its folder; resting on it lists its subfolders
                  under it (the cascade, folders only). Too narrow: the first crumbs
                  give way to "…" (TrailPanel), the end of the path stays. A press on the blank part
                  (or Ctrl+L / Alt+D / F4) opens the edit box with the path selected: Enter goes to a
                  typed path or runs a command in the folder (cmd, wsl, powershell, …), Esc gives up.
                  The crumbs stay laid out (Hidden) under the box, so the bar keeps its height. The box
                  is Collapsed while not editing: a TextBox in the layout keeps telling the IME (TSF)
                  about its layout, and the IME's answer lays out the whole window under its lock
                  (with UI Automation listening, that hung the app on a big folder).
                -->
                <Border Grid.Column="1" x:Name="AddressBar" Margin="4,0,8,0" VerticalAlignment="Center" CornerRadius="6" BorderThickness="1"
                        Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                        MouseLeftButtonUp="OnAddressBarClick">
                    <Grid>
                        <Border Background="Transparent" Cursor="IBeam"
                                ToolTip="{views:ShortcutTip Text=クリックでパスを入力・コピー, Id=Address, Tail=。cmd・wsl・powershell などと入力すると、このフォルダで開きます}" />
                        <!-- the "…" lies over the room TrailPanel keeps free at the start while it leaves crumbs out -->
                        <Grid x:Name="Crumbs" Margin="1,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <ItemsControl x:Name="CrumbItems" ItemsSource="{Binding ActivePane.Breadcrumbs}" ClipToBounds="True" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <views:TrailPanel LeadWidth="20" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:BreadcrumbItem}">
                                        <!-- a DockPanel, not a StackPanel: the button gets the width that is left, so a
                                             last crumb too long for the bar trims its name (TrailPanel measures it narrower) -->
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Separator}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Muted}" />
                                            <!-- resting on it lists its subfolders under it (the cascade: BreadcrumbItem is an anchor) -->
                                            <Button x:Name="CrumbButton" Style="{StaticResource Btn.Crumb}" Padding="4,3" ToolTip="{Binding ToolTip}"
                                                    Command="{Binding DataContext.NavigateCrumbCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                    CommandParameter="{Binding}"
                                                    MouseEnter="OnCrumbMouseEnter" MouseMove="OnCrumbMouseMove" MouseLeave="OnCrumbMouseLeave"
                                                    PreviewMouseDown="OnCrumbMouseDown">
                                                <TextBlock x:Name="CrumbText" Text="{Binding Text}" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                                            </Button>
                                        </DockPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsLast}" Value="True">
                                                <Setter TargetName="CrumbText" Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                            <!-- the list under it is showing: highlighted as under the pointer, and no tooltip over the list -->
                                            <DataTrigger Binding="{Binding IsHoverHeld}" Value="True">
                                                <Setter TargetName="CrumbButton" Property="Background" Value="{DynamicResource Brush.Surface3}" />
                                                <Setter TargetName="CrumbButton" Property="ToolTipService.IsEnabled" Value="False" />
                                            </DataTrigger>
                                            <!-- a drag would drop into this folder (IsMouseOver does not follow a drag) -->
                                            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                                <Setter TargetName="CrumbButton" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="…" Margin="6,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Muted}"
                                       ToolTip="{Binding ActivePane.AddressText}"
                                       Visibility="{Binding (views:TrailPanel.IsTrimmed), ElementName=CrumbItems, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                        <TextBox x:Name="AddressEdit" Style="{StaticResource AddressBox}" Visibility="Collapsed"
                                 AutomationProperties.Name="アドレス" PreviewKeyDown="OnAddressKeyDown" LostKeyboardFocus="OnAddressLostFocus" />
                    </Grid>
                </Border>

                <!-- its width is held while the address bar's edit box is open (BeginAddressEdit) -->
                <StackPanel x:Name="CountPanel" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,12,0" ClipToBounds="True">
                    <TextBlock Text="{Binding ActivePane.ShownCountText}" Foreground="{DynamicResource Brush.Muted}"
                               VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                    <!-- 「3 個を選択」 while items are selected -->
                    <TextBlock Text="{Binding ActivePane.SelectionText}" Foreground="{DynamicResource Brush.Accent}" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="10,0,0,0" Typography.NumeralAlignment="Tabular"
                               Visibility="{Binding ActivePane.SelectionText, Converter={StaticResource NotEmptyToVis}}" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <!--
                      Search of the shown list (Ctrl+F / F3): the items whose name holds every word typed
                      (PaneViewModel.SearchText). Right of the count, so that a count that changes while
                      typing does not move the box. The box is Collapsed except while typing (as the
                      address bar's edit box, see above: a TextBox in the layout keeps the IME busy);
                      while a search is on and the box is closed, the chip shows it (a click edits it,
                      × clears it). The box lies over the chip while open.
                    -->
                    <Grid Margin="0,0,8,0" VerticalAlignment="Center">
                        <Border x:Name="SearchChip" CornerRadius="6" BorderThickness="1" Padding="8,2,2,2" Cursor="IBeam"
                                BorderBrush="{DynamicResource Brush.Accent}" Background="{DynamicResource Brush.AccentSoft}"
                                ToolTip="{views:ShortcutTip Text=一覧を名前で絞り込み中。クリックで編集, Id=Search, Tail=、× で解除}"
                                Visibility="{Binding ActivePane.IsSearching, Converter={StaticResource BoolToVis}}"
                                MouseLeftButtonUp="OnSearchChipClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE721;" FontFamily="{StaticResource Font.Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"
                                           Foreground="{DynamicResource Brush.Accent}" />
                                <TextBlock Text="{Binding ActivePane.SearchText}" MaxWidth="180" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <Button Style="{StaticResource Btn.TabClose}" Margin="4,0,0,0" ToolTip="検索を解除" Click="OnSearchClearClick" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="SearchBox" Width="220" Visibility="Collapsed" CornerRadius="6" BorderThickness="1" Padding="6,0,0,0"
                                BorderBrush="{DynamicResource Brush.Accent}" Background="{DynamicResource Brush.Surface}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="&#xE721;" FontFamily="{StaticResource Font.Icons}" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.Muted}" />
                                <TextBox x:Name="SearchEdit" Style="{StaticResource AddressBox}" Height="24" AutomationProperties.Name="検索"
                                         PreviewKeyDown="OnSearchKeyDown" LostKeyboardFocus="OnSearchLostFocus" TextChanged="OnSearchTextChanged" />
                            </DockPanel>
                        </Border>
                    </Grid>
                    <Button Style="{StaticResource Btn}" Content="履歴をクリア" Margin="0,0,8,0" Padding="10,4"
                            Command="{Binding ClearHistoryCommand}"
                            Visibility="{Binding ActivePane.ShowClearHistory, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <!-- what the list of 最近の履歴 / よく使う項目 shows: everything, folders only, files only -->
                <Button Grid.Column="4" Style="{StaticResource Btn}" Margin="0,0,8,0" Padding="10,4" Click="OnFilterClick"
                        ToolTip="表示する項目（タブごと）：すべて / フォルダのみ / ファイルのみ"
                        Visibility="{Binding ActivePane.ShowFilter, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71C;" FontFamily="{StaticResource Font.Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding ActivePane.FilterText}" VerticalAlignment="Center" />
                        <TextBlock Text="&#xE70D;" FontFamily="{StaticResource Font.Icons}" FontSize="9" VerticalAlignment="Center" Margin="6,1,0,0"
                                   Foreground="{DynamicResource Brush.Muted}" />
                    </StackPanel>
                </Button>

                <!-- sort mode of the selected tab -->
                <Button Grid.Column="5" Style="{StaticResource Btn}" Margin="0,0,10,0" Padding="10,4" Click="OnSortClick"
                        ToolTip="並べ替え（タブごと。一覧の空いているところの右クリックからも選べます）。一覧はドラッグで並べた順、フォルダの中は既定の順（フォルダ→ファイル、名前順）が「手動」です。ピン留めした項目は位置が固定されます。">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8CB;" FontFamily="{StaticResource Font.Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding ActivePane.SortModeText}" VerticalAlignment="Center" />
                        <TextBlock Text="&#xE70D;" FontFamily="{StaticResource Font.Icons}" FontSize="9" VerticalAlignment="Center" Margin="6,1,0,0"
                                   Foreground="{DynamicResource Brush.Muted}" />
                    </StackPanel>
                </Button>

                <!--
                  View mode of the shown tab (each tab keeps its own: PaneViewModel.CardShape; MainViewModel.CardShape
                  mirrors it): tall cards, square cards, or the details list. A click runs the
                  command; Checked covers the choices made without a click (UI Automation selects a radio
                  button by checking it), see OnViewModeChecked.
                -->
                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <RadioButton Style="{StaticResource Toggle.Segment}" GroupName="CardShape" ToolTip="カードの形：縦長" AutomationProperties.Name="カードの形：縦長"
                                 IsChecked="{Binding CardShape, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Portrait}"
                                 Command="{Binding SetCardShapeCommand}" CommandParameter="{x:Static layout:CardShape.Portrait}"
                                 Checked="OnViewModeChecked">
                        <Rectangle Width="10" Height="14" RadiusX="1.5" RadiusY="1.5" StrokeThickness="1.5"
                                   Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}" />
                    </RadioButton>
                    <RadioButton Style="{StaticResource Toggle.Segment}" GroupName="CardShape" ToolTip="カードの形：正方形" AutomationProperties.Name="カードの形：正方形" Margin="2,0,0,0"
                                 IsChecked="{Binding CardShape, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Square}"
                                 Command="{Binding SetCardShapeCommand}" CommandParameter="{x:Static layout:CardShape.Square}"
                                 Checked="OnViewModeChecked">
                        <Rectangle Width="13" Height="13" RadiusX="1.5" RadiusY="1.5" StrokeThickness="1.5"
                                   Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}" />
                    </RadioButton>
                    <RadioButton Style="{StaticResource Toggle.Segment}" GroupName="CardShape" ToolTip="表示：詳細" AutomationProperties.Name="表示：詳細" Margin="2,0,0,0"
                                 IsChecked="{Binding CardShape, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Details}"
                                 Command="{Binding SetCardShapeCommand}" CommandParameter="{x:Static layout:CardShape.Details}"
                                 Checked="OnViewModeChecked">
                        <!-- three bars: the rows of a list -->
                        <StackPanel Width="12">
                            <Rectangle Height="1.5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}" />
                            <Rectangle Height="1.5" Margin="0,3,0,0" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}" />
                            <Rectangle Height="1.5" Margin="0,3,0,0" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}" />
                        </StackPanel>
                    </RadioButton>

                    <!-- split the active pane (MainViewModel.SplitPaneCommand): left | right, top / bottom -->
                    <Button Style="{StaticResource Btn.Icon}" Width="30" Height="28" Margin="10,0,0,0"
                            ToolTip="{views:ShortcutTip Text=左右に分割, Id=SplitColumns}" AutomationProperties.Name="左右に分割"
                            ToolTipService.ShowOnDisabled="True"
                            Command="{Binding SplitPaneCommand}" CommandParameter="{x:Static layout:SplitAxis.Columns}">
                        <Grid Width="14" Height="12">
                            <Rectangle RadiusX="1.5" RadiusY="1.5" StrokeThickness="1.5"
                                       Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                            <Rectangle Width="1.5" HorizontalAlignment="Center"
                                       Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource Btn.Icon}" Width="30" Height="28" Margin="2,0,0,0"
                            ToolTip="{views:ShortcutTip Text=上下に分割, Id=SplitRows}" AutomationProperties.Name="上下に分割"
                            ToolTipService.ShowOnDisabled="True"
                            Command="{Binding SplitPaneCommand}" CommandParameter="{x:Static layout:SplitAxis.Rows}">
                        <Grid Width="14" Height="12">
                            <Rectangle RadiusX="1.5" RadiusY="1.5" StrokeThickness="1.5"
                                       Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                            <Rectangle Height="1.5" VerticalAlignment="Center"
                                       Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- card size: nothing to size in the details list (disabled there, the value is kept) -->
                <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0"
                            ToolTipService.ShowOnDisabled="True">
                    <StackPanel.Style>
                        <Style TargetType="{x:Type StackPanel}">
                            <Setter Property="ToolTip" Value="カードの大きさ（Ctrl + ホイールでも変更できます）" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CardShape}" Value="{x:Static layout:CardShape.Details}">
                                    <Setter Property="IsEnabled" Value="False" />
                                    <Setter Property="Opacity" Value="0.4" />
                                    <Setter Property="ToolTip" Value="カードの大きさ（詳細表示では使いません）" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="&#xE71E;" FontFamily="{StaticResource Font.Icons}" FontSize="13" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Muted}" Margin="0,0,6,0" />
                    <Slider x:Name="SizeSlider" Width="110" Minimum="120" Maximum="400" TickFrequency="20" SmallChange="20" LargeChange="40"
                            IsSnapToTickEnabled="True" VerticalAlignment="Center" Focusable="False"
                            Value="{Binding CardSize, Mode=TwoWay}" />
                </StackPanel>

                <Grid Grid.Column="8">
                    <Button Style="{StaticResource Btn.Icon}" Content="&#xE72C;" ToolTip="{views:ShortcutTip Text=更新, Id=Refresh}"
                            Command="{Binding RefreshCommand}"
                            IsEnabled="{Binding ActivePane.IsLoading, Converter={StaticResource Not}}" />
                    <ContentControl Style="{StaticResource Spinner}" Width="16" Height="16"
                                    Visibility="{Binding ActivePane.IsLoading, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Grid>
        </Border>

        <!-- Messages (§5.4) -->
        <StackPanel Grid.Row="2">
            <!-- top: メッセージの表示 = 上 (and all but success while it is 表示しない); the bottom one is under ContentHost -->
            <Border Style="{StaticResource MessageBar}" Visibility="{Binding Message.ShowsAtTop, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="24" Height="22" FontSize="10" Content="&#xE711;"
                            ToolTip="閉じる" Click="OnHideMessage" Foreground="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType={x:Type Border}}}" />
                    <TextBlock Text="{Binding Message.Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
            <!-- each pane's notice and error banner are at the top of the pane (PaneView) -->
        </StackPanel>

        <!--
          The items of the shown tab (§6): its panes (PaneView), each with the card grid or the
          details list by its own view mode.
        -->
        <!-- transparent, not null: a press on the blank area clears the selection, a right click there offers 貼り付け -->
        <Grid x:Name="ContentHost" Grid.Row="3" Background="Transparent">
            <!-- The panes of the shown tab: one PaneView each, with splitters between them (MainWindow.BuildPanes from ShownLayout) -->
            <Border x:Name="PaneArea" />

            <!-- Empty state: every tab was closed (the placeholder tab is selected: no cards, no texts of its own) -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                <StackPanel.Style>
                    <Style TargetType="{x:Type StackPanel}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasTab}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="開いているタブはありません。左のメニューから項目を選んでください。" Foreground="{DynamicResource Brush.Muted}"
                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="560" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                    <Button Style="{StaticResource Btn}" Padding="14,6" Content="最近の履歴を開く"
                            CommandParameter="{x:Static vm:TabKind.Recent}" Command="{Binding OpenQuickTabCommand}" />
                    <Button Style="{StaticResource Btn}" Padding="14,6" Margin="10,0,0,0" Content="よく使う項目を開く"
                            CommandParameter="{x:Static vm:TabKind.Frequent}" Command="{Binding OpenQuickTabCommand}" />
                </StackPanel>
            </StackPanel>

        </Grid>

        <!-- Message line at the bottom of the main area (メッセージの表示 = 下): its own row, so it never covers items -->
        <Border Grid.Row="4" Style="{StaticResource MessageBar}" Margin="16,6,16,8"
                Visibility="{Binding Message.ShowsAtBottom, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="24" Height="22" FontSize="10" Content="&#xE711;"
                        ToolTip="閉じる" Click="OnHideMessage" Foreground="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType={x:Type Border}}}" />
                <TextBlock Text="{Binding Message.Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
      </Grid>
    </Grid>
</Window>
