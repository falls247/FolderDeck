<Window x:Class="FolderDeck.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FolderDeck.Views"
        xmlns:vm="clr-namespace:FolderDeck.ViewModels"
        xmlns:layout="clr-namespace:FolderDeck.Core.Layout;assembly=FolderDeck.Core"
        Title="FolderDeck" Width="1280" Height="800" MinWidth="960" MinHeight="420"
        Background="{DynamicResource Brush.Bg}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource Font.UI}" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True" AllowDrop="True"
        Icon="pack://application:,,,/FolderDeck;component/Assets/FolderDeck.ico">
    <Window.Resources>
        <views:EnumEqualsConverter x:Key="EnumEquals" />
        <views:NotEmptyToVisibilityConverter x:Key="NotEmptyToVis" />
        <views:InverseBoolConverter x:Key="Not" />

        <Style x:Key="MessageBar" TargetType="{x:Type Border}">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="16,8,16,0" />
            <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Accent}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Message.Kind}" Value="{x:Static vm:MessageKind.Success}">
                    <Setter Property="Background" Value="{DynamicResource Brush.OkSoft}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Ok}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Message.Kind}" Value="{x:Static vm:MessageKind.Warning}">
                    <Setter Property="Background" Value="{DynamicResource Brush.WarnSoft}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Warn}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Message.Kind}" Value="{x:Static vm:MessageKind.Error}">
                    <Setter Property="Background" Value="{DynamicResource Brush.DangerSoft}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Danger}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
      <Grid.ColumnDefinitions>
          <!-- the width is set from settings.json in code (sidebar_width) and changed with the splitter -->
          <ColumnDefinition x:Name="SidebarColumn" Width="220" MinWidth="140" MaxWidth="480" />
          <ColumnDefinition Width="Auto" />
          <!-- 690: the toolbar of 最近の履歴 (count, clear, filter, sort, shape, size, refresh) without clipping -->
          <ColumnDefinition Width="*" MinWidth="690" />
      </Grid.ColumnDefinitions>

      <!-- Sidebar: 登録フォルダ (§10.1). One row per folder; resting on a row opens the cascade. -->
      <Border Grid.Column="0" Background="{DynamicResource Brush.Surface}">
          <Grid>
              <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <DockPanel Grid.Row="0" Margin="14,6,6,4" Height="32">
                  <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="30" Height="28" FontSize="14" Content="&#xE8F4;"
                          ToolTip="フォルダを選んで登録…（エクスプローラーからフォルダをドロップしても登録できます）" Command="{Binding BrowseCommand}" />
                  <TextBlock Text="登録フォルダ" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Folder}" />
                  <TextBlock Text="{Binding RegisteredCountText}" Margin="8,0,0,0" VerticalAlignment="Center"
                             Foreground="{DynamicResource Brush.Muted}" Typography.NumeralAlignment="Tabular" />
              </DockPanel>
              <views:SidebarView x:Name="Sidebar" Grid.Row="1" />
              <TextBlock Grid.Row="1" Margin="14,10,12,0" VerticalAlignment="Top" TextWrapping="Wrap" FontSize="12"
                         Foreground="{DynamicResource Brush.Muted}" IsHitTestVisible="False"
                         Text="登録フォルダはまだありません。右上のボタンでフォルダを選ぶか、エクスプローラーからフォルダをドロップして追加してください。"
                         Visibility="{Binding HasNoRegistered, Converter={StaticResource BoolToVis}}" />

              <!-- drop hint while dragging folders from Explorer over the window -->
              <Border x:Name="DropHint" Grid.RowSpan="2" Margin="6" CornerRadius="10" BorderThickness="2" BorderBrush="{DynamicResource Brush.Folder}"
                      Background="{DynamicResource Brush.FolderSoft}" Opacity="0.94" Visibility="Collapsed" IsHitTestVisible="False">
                  <TextBlock Text="ドロップして登録" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Folder}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="8" />
              </Border>
          </Grid>
      </Border>

      <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                    ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" Focusable="False" Cursor="SizeWE"
                    Background="{DynamicResource Brush.Border}" ToolTip="ドラッグで登録フォルダの幅を変更"
                    DragStarted="OnSplitterDragStarted" DragCompleted="OnSplitterDragCompleted" />

      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Tabs + settings (§5.1): the two fixed tabs (accent colour), then the folder tabs (folder colour) -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <DockPanel Margin="8,0,8,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Content="&#xE713;" ToolTip="設定"
                        Command="{Binding OpenSettingsCommand}" VerticalAlignment="Center" />
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <RadioButton Style="{StaticResource TabButton}" GroupName="Tabs" Content="最近の履歴"
                                 IsChecked="{Binding RecentTab.IsSelected, Mode=OneWay}"
                                 Command="{Binding SelectTabCommand}" CommandParameter="{Binding RecentTab}" />
                    <RadioButton Style="{StaticResource TabButton}" GroupName="Tabs" Content="よく使う項目"
                                 IsChecked="{Binding FrequentTab.IsSelected, Mode=OneWay}"
                                 Command="{Binding SelectTabCommand}" CommandParameter="{Binding FrequentTab}" />
                    <Border Width="1" Margin="6,10,8,10" Background="{DynamicResource Brush.Border}" />
                </StackPanel>
                <views:FolderTabStrip x:Name="TabStrip" />
            </DockPanel>
        </Border>

        <!-- Toolbar (§5.3) -->
        <Border Grid.Row="1" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource Btn.Icon}" Content="&#xE74A;" ToolTip="1つ上へ（Backspace）"
                        Command="{Binding GoUpCommand}" />

                <!-- breadcrumb -->
                <ItemsControl Grid.Column="1" x:Name="Crumbs" ItemsSource="{Binding SelectedTab.Breadcrumbs}" Margin="4,0,8,0"
                              VerticalAlignment="Center" ClipToBounds="True" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:BreadcrumbItem}">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="Crumb" Style="{StaticResource Btn.Crumb}" ToolTip="{Binding ToolTip}"
                                        Command="{Binding DataContext.NavigateCrumbCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                        CommandParameter="{Binding}">
                                    <TextBlock x:Name="CrumbText" Text="{Binding Text}" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                                </Button>
                                <TextBlock x:Name="Dots" Text="…" Margin="6,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Muted}"
                                           ToolTip="{Binding ToolTip}" Visibility="Collapsed" />
                                <TextBlock x:Name="Sep" Text="/" Margin="2,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Muted}" />
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsLast}" Value="True">
                                    <Setter TargetName="Sep" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="CrumbText" Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsEllipsis}" Value="True">
                                    <Setter TargetName="Crumb" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="Dots" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Grid.Column="2" Text="{Binding SelectedTab.CountText}" Foreground="{DynamicResource Brush.Muted}"
                           VerticalAlignment="Center" Margin="8,0,12,0" Typography.NumeralAlignment="Tabular" />

                <Button Grid.Column="3" Style="{StaticResource Btn}" Content="履歴をクリア" Margin="0,0,8,0" Padding="10,4"
                        Command="{Binding ClearHistoryCommand}"
                        Visibility="{Binding SelectedTab.ShowClearHistory, Converter={StaticResource BoolToVis}}" />

                <!-- what the list of 最近の履歴 / よく使う項目 shows: everything, folders only, files only -->
                <Button Grid.Column="4" Style="{StaticResource Btn}" Margin="0,0,8,0" Padding="10,4" Click="OnFilterClick"
                        ToolTip="表示する項目（タブごと）：すべて / フォルダのみ / ファイルのみ"
                        Visibility="{Binding SelectedTab.ShowFilter, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71C;" FontFamily="{StaticResource Font.Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding SelectedTab.FilterText}" VerticalAlignment="Center" />
                        <TextBlock Text="&#xE70D;" FontFamily="{StaticResource Font.Icons}" FontSize="9" VerticalAlignment="Center" Margin="6,1,0,0"
                                   Foreground="{DynamicResource Brush.Muted}" />
                    </StackPanel>
                </Button>

                <!-- sort mode of the selected tab -->
                <Button Grid.Column="5" Style="{StaticResource Btn}" Margin="0,0,10,0" Padding="10,4" Click="OnSortClick"
                        ToolTip="並べ替え（最近の履歴・よく使う項目はタブごと、フォルダのタブは共通）。一覧はドラッグで並べた順、フォルダの中は既定の順（フォルダ→ファイル、名前順）が「手動」です。ピン留めした項目は位置が固定されます。">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8CB;" FontFamily="{StaticResource Font.Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding SelectedTab.SortModeText}" VerticalAlignment="Center" />
                        <TextBlock Text="&#xE70D;" FontFamily="{StaticResource Font.Icons}" FontSize="9" VerticalAlignment="Center" Margin="6,1,0,0"
                                   Foreground="{DynamicResource Brush.Muted}" />
                    </StackPanel>
                </Button>

                <!-- card shape (every tab): tall rectangle or square -->
                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <RadioButton Style="{StaticResource Toggle.Segment}" GroupName="CardShape" ToolTip="カードの形：縦長"
                                 IsChecked="{Binding CardShape, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Portrait}"
                                 Command="{Binding SetCardShapeCommand}" CommandParameter="{x:Static layout:CardShape.Portrait}">
                        <Rectangle Width="10" Height="14" RadiusX="1.5" RadiusY="1.5" StrokeThickness="1.5"
                                   Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}" />
                    </RadioButton>
                    <RadioButton Style="{StaticResource Toggle.Segment}" GroupName="CardShape" ToolTip="カードの形：正方形" Margin="2,0,0,0"
                                 IsChecked="{Binding CardShape, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Square}"
                                 Command="{Binding SetCardShapeCommand}" CommandParameter="{x:Static layout:CardShape.Square}">
                        <Rectangle Width="13" Height="13" RadiusX="1.5" RadiusY="1.5" StrokeThickness="1.5"
                                   Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}" />
                    </RadioButton>
                </StackPanel>

                <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0"
                            ToolTip="カードの大きさ（Ctrl + ホイールでも変更できます）">
                    <TextBlock Text="&#xE71E;" FontFamily="{StaticResource Font.Icons}" FontSize="13" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Muted}" Margin="0,0,6,0" />
                    <Slider x:Name="SizeSlider" Width="110" Minimum="120" Maximum="400" TickFrequency="20" SmallChange="20" LargeChange="40"
                            IsSnapToTickEnabled="True" VerticalAlignment="Center" Focusable="False"
                            Value="{Binding CardSize, Mode=TwoWay}" />
                </StackPanel>

                <Grid Grid.Column="8">
                    <Button Style="{StaticResource Btn.Icon}" Content="&#xE72C;" ToolTip="更新（F5）"
                            Command="{Binding RefreshCommand}"
                            IsEnabled="{Binding SelectedTab.IsLoading, Converter={StaticResource Not}}" />
                    <ContentControl Style="{StaticResource Spinner}" Width="16" Height="16"
                                    Visibility="{Binding SelectedTab.IsLoading, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Grid>
        </Border>

        <!-- Messages, notice, error banner (§5.4, §8.4, §10.2) -->
        <StackPanel Grid.Row="2">
            <Border Style="{StaticResource MessageBar}" Visibility="{Binding Message.IsVisible, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="24" Height="22" FontSize="10" Content="&#xE711;"
                            ToolTip="閉じる" Click="OnHideMessage" Foreground="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType={x:Type Border}}}" />
                    <TextBlock Text="{Binding Message.Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
            <Border Margin="16,8,16,0" Padding="12,7" CornerRadius="8" Background="{DynamicResource Brush.WarnSoft}"
                    Visibility="{Binding SelectedTab.NoticeText, Converter={StaticResource NotEmptyToVis}}">
                <TextBlock Text="{Binding SelectedTab.NoticeText}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Warn}" />
            </Border>
            <Border Margin="16,8,16,0" Padding="12,8" CornerRadius="8" Background="{DynamicResource Brush.DangerSoft}"
                    Visibility="{Binding SelectedTab.BannerText, Converter={StaticResource NotEmptyToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Padding="10,3" Margin="12,0,0,0"
                            Command="{Binding BackToTopCommand}" Content="{Binding SelectedTab.BackText}" />
                    <TextBlock Text="{Binding SelectedTab.BannerText}" TextWrapping="Wrap" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Danger}" />
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- Card grid (§6) -->
        <Grid Grid.Row="3">
            <views:CardGrid x:Name="Grid" Items="{Binding SelectedTab.Cards}" CardSize="{Binding CardSize}" CardShape="{Binding CardShape}">
                <views:CardGrid.Style>
                    <Style TargetType="{x:Type views:CardGrid}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTab.IsLoading}" Value="True">
                                <Setter Property="Opacity" Value="0.55" />
                                <Setter Property="IsHitTestVisible" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:CardGrid.Style>
            </views:CardGrid>

            <TextBlock Text="{Binding SelectedTab.EmptyText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.Muted}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="560" Margin="24"
                       IsHitTestVisible="False" Visibility="{Binding SelectedTab.EmptyText, Converter={StaticResource NotEmptyToVis}}" />

            <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0" Padding="14,8" CornerRadius="8"
                    Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1"
                    Visibility="{Binding SelectedTab.IsSlow, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <ContentControl Style="{StaticResource Spinner}" Margin="0,0,8,0" />
                    <TextBlock Text="応答がありません（待機中…）" Foreground="{DynamicResource Brush.Muted}" />
                </StackPanel>
            </Border>

        </Grid>
      </Grid>
    </Grid>
</Window>
