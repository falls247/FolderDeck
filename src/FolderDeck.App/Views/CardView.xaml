<UserControl x:Class="FolderDeck.Views.CardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FolderDeck.Views"
             xmlns:vm="clr-namespace:FolderDeck.ViewModels"
             xmlns:shell="clr-namespace:FolderDeck.Shell"
             Focusable="False"
             Cursor="Hand"
             ToolTipService.InitialShowDelay="900"
             ToolTipService.Placement="Mouse"
             ToolTip="{Binding ToolTipText}">
    <UserControl.Resources>
        <Style x:Key="Pill" TargetType="{x:Type Border}">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="7,1,7,2" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Background" Value="{DynamicResource Brush.Surface3}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Muted}" />
        </Style>
        <Style x:Key="PillAccent" TargetType="{x:Type Border}" BasedOn="{StaticResource Pill}">
            <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Accent}" />
        </Style>
        <Style x:Key="PillWarn" TargetType="{x:Type Border}" BasedOn="{StaticResource Pill}">
            <Setter Property="Background" Value="{DynamicResource Brush.WarnSoft}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Warn}" />
        </Style>
        <Style x:Key="PillText" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="PillGlyph" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{StaticResource Font.Icons}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,1,4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Root" Background="Transparent">
        <!-- weak card shadow (cheap: a dark rounded rect 1 px below) -->
        <Border x:Name="FakeShadow" CornerRadius="10" Background="{DynamicResource Brush.CardShadow}" Margin="0,1,0,-1" />

        <Border x:Name="CardBorder" CornerRadius="10" BorderThickness="1"
                BorderBrush="{DynamicResource Brush.Border}">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
                    <Style.Triggers>
                        <!-- selected: the footer takes the accent tint (the frame is SelectionFrame below) -->
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.RenderTransform>
                <TranslateTransform x:Name="Lift" Y="0" />
            </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="{Binding Metrics.ThumbHeight, RelativeSource={RelativeSource AncestorType={x:Type views:CardGrid}}}" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Thumbnail: 3:4 (portrait) or 1:1 (square), height from CardGrid.Metrics.ThumbHeight -->
                <Grid x:Name="ThumbArea" Grid.Row="0" Background="{DynamicResource Brush.Surface3}" ClipToBounds="True">
                    <Image x:Name="ThumbImage" Source="{Binding Thumbnail}" Stretch="UniformToFill"
                           HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <Image x:Name="ShellImage" Source="{Binding Thumbnail}" Stretch="Uniform" Margin="18"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <Image x:Name="IconImage" Source="{Binding Thumbnail}" Stretch="Uniform"
                           Width="{Binding Metrics.IconSize, RelativeSource={RelativeSource AncestorType={x:Type views:CardGrid}}}"
                           Height="{Binding Metrics.IconSize, RelativeSource={RelativeSource AncestorType={x:Type views:CardGrid}}}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock x:Name="WarnGlyph" Text="&#xE7BA;" FontFamily="{StaticResource Font.Icons}" FontSize="40"
                               Foreground="{DynamicResource Brush.Warn}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="Collapsed" />
                    <ContentPresenter x:Name="OverlayHost" />
                </Grid>

                <!-- Footer: name (always two lines high), sub line, badges. The text follows
                     文字の大きさ (Size.Card.*, TextScale), so the footer, and the card, grow with it. -->
                <StackPanel Grid.Row="1" Margin="10,8,10,9">
                    <TextBlock x:Name="NameText" Text="{Binding Name}" FontSize="{DynamicResource Size.Card.NameFont}" Foreground="{DynamicResource Brush.Text}"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               LineHeight="{DynamicResource Size.Card.NameLine}" LineStackingStrategy="BlockLineHeight"
                               MinHeight="{DynamicResource Size.Card.NameBox}" MaxHeight="{DynamicResource Size.Card.NameBox}" />
                    <TextBlock x:Name="SubLine" Text="{Binding SubText}" FontSize="{DynamicResource Size.Card.SubFont}" Foreground="{DynamicResource Brush.Muted}"
                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SubText}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Grid Margin="0,6,0,0" Height="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!--
                          📌 on every pinned item (all tabs, inside folders too), bottom-left: the hover
                          overlay covers only the thumbnail, so it stays visible and clickable (unpins).
                        -->
                        <Button x:Name="PinButton" Grid.Column="0" Style="{StaticResource Btn.CardPin}" Margin="0,0,6,0"
                                Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}" Click="OnPinClick" />
                        <!--
                          Badges, right-aligned. Too wide for what is left (small cards, beside the 📌,
                          long counts) they shrink to fit instead of being cut off on the left.
                        -->
                        <Viewbox Grid.Column="1" StretchDirection="DownOnly" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Grid>
                                <!-- pending -->
                                <StackPanel x:Name="BadgePending" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Collapsed">
                                    <Border Style="{StaticResource Pill}">
                                        <TextBlock Text="…" Style="{StaticResource PillText}" />
                                    </Border>
                                </StackPanel>
                                <!-- folder counts -->
                                <StackPanel x:Name="BadgeFolder" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Collapsed">
                                    <Border Style="{StaticResource PillAccent}" Visibility="{Binding ShowFolderCount, Converter={StaticResource BoolToVis}}"
                                            ToolTip="フォルダ数">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8B7;" Style="{StaticResource PillGlyph}" />
                                            <TextBlock Text="{Binding FolderCountText}" Style="{StaticResource PillText}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource PillAccent}" Visibility="{Binding ShowFileCount, Converter={StaticResource BoolToVis}}"
                                            ToolTip="ファイル数">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8A5;" Style="{StaticResource PillGlyph}" />
                                            <TextBlock Text="{Binding FileCountText}" Style="{StaticResource PillText}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <!-- file: extension + size -->
                                <StackPanel x:Name="BadgeFile" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Collapsed">
                                    <Border Style="{StaticResource Pill}">
                                        <TextBlock Text="{Binding ExtensionText}" Style="{StaticResource PillText}" />
                                    </Border>
                                    <Border>
                                        <Border.Style>
                                            <Style TargetType="{x:Type Border}" BasedOn="{StaticResource Pill}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SizeText}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding SizeText}" Style="{StaticResource PillText}" />
                                    </Border>
                                </StackPanel>
                                <!-- missing / no response / error -->
                                <StackPanel x:Name="BadgeWarn" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Collapsed">
                                    <Border Style="{StaticResource PillWarn}">
                                        <TextBlock x:Name="WarnText" Text="見つかりません" Style="{StaticResource PillText}" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Viewbox>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!--
          Selection frame: 2 px of accent over the card's own 1 px border, drawn on top so that the
          layout does not move; it moves with the card's lift and lets every press through.
        -->
        <Border x:Name="SelectionFrame" CornerRadius="10" BorderThickness="2" IsHitTestVisible="False"
                RenderTransform="{Binding RenderTransform, ElementName=CardBorder}">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <!--
          Keyboard cursor (IsCursor: the keys moved it last, a mouse press hides it): a dashed line
          inside the selection frame, as Explorer's focus rectangle, so that it shows on a selected
          card as well as on one the cursor alone is on (Ctrl + arrows).
        -->
        <Rectangle x:Name="CursorFrame" Margin="4" RadiusX="7" RadiusY="7" StrokeThickness="1.5" StrokeDashArray="2 2"
                   Stroke="{DynamicResource Brush.Accent}" IsHitTestVisible="False"
                   RenderTransform="{Binding RenderTransform, ElementName=CardBorder}"
                   Visibility="{Binding IsCursor, Converter={StaticResource BoolToVis}}" />

        <!-- × (§6.7) -->
        <Button x:Name="CloseButton" Style="{StaticResource Btn.CardClose}" Content="&#xE711;"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0"
                Visibility="Collapsed" ToolTip="{Binding RemoveToolTip}" Click="OnCloseClick" />

        <!-- opening… (§6.8) -->
        <Border x:Name="BusyScrim" CornerRadius="10" Background="{StaticResource Busy.Scrim}"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <ContentControl Style="{StaticResource Spinner}" Width="26" Height="26" Foreground="White" />
        </Border>
    </Grid>
</UserControl>
