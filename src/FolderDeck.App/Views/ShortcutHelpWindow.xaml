<Window x:Class="FolderDeck.Views.ShortcutHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FolderDeck.Views"
        Title="キーボード ショートカット" SizeToContent="Height" Width="640" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Surface}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource Font.UI}" FontSize="13" UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Margin="22,16,22,4" FontSize="16" FontWeight="SemiBold" Text="キーボード ショートカット" />

        <!-- focusable: ↑ ↓ PageUp PageDown scroll the list (the close button would take them otherwise) -->
        <ScrollViewer x:Name="ListScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      FocusVisualStyle="{x:Null}">
            <ItemsControl x:Name="GroupList" Margin="22,0,22,0" Focusable="False" Grid.IsSharedSizeScope="True">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type views:ShortcutGroup}">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Muted}" Margin="0,14,0,6" />
                            <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type views:Shortcut}">
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" MinWidth="200" SharedSizeGroup="Keys" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,16,0" Padding="7,1" CornerRadius="4"
                                                    Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                                <TextBlock Text="{Binding Keys}" FontSize="12" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Description}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="22,14,22,16" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Muted}" FontSize="12"
                       Text="入力欄の中・メニューの表示中・名前の入力中は、一覧のキーは効きません。" TextWrapping="Wrap" MaxWidth="420" />
            <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="閉じる" MinWidth="100" IsCancel="True" />
        </DockPanel>
    </Grid>
</Window>
