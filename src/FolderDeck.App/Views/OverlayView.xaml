<UserControl x:Class="FolderDeck.Views.OverlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FolderDeck.Views"
             Focusable="False" Cursor="Arrow" Opacity="0">
    <!-- Level 1 of the cascade: drawn over the card's thumbnail area (§9.2). -->
    <Border Background="{StaticResource Overlay.Bg}" TextElement.Foreground="{StaticResource Overlay.Text}">
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{StaticResource Overlay.HeaderBg}" Padding="10,8,10,6">
                <TextBlock Text="{Binding HeaderCounts}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Overlay.Muted}"
                           TextTrimming="CharacterEllipsis" />
            </Border>
            <views:EntryListView x:Name="Rows" Margin="10,2,6,8" />
        </DockPanel>
    </Border>
</UserControl>
