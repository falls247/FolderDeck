<Window x:Class="FolderDeck.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FolderDeck" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Surface}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource Font.UI}" FontSize="13" UseLayoutRounding="True">
    <StackPanel Margin="22,18,22,16" MinWidth="380" MaxWidth="560">
        <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10" />
        <TextBlock x:Name="BodyText" TextWrapping="Wrap" LineHeight="20" />
        <Border x:Name="PathBox" Margin="0,12,0,0" Padding="10,7" CornerRadius="6" Background="{DynamicResource Brush.Surface3}">
            <TextBlock x:Name="PathText" FontFamily="{StaticResource Font.Mono}" FontSize="12" TextWrapping="Wrap" />
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="PrimaryButton" Style="{StaticResource Btn.Primary}" MinWidth="110" Margin="0,0,8,0" Click="OnPrimary" />
            <Button x:Name="CancelButton" Style="{StaticResource Btn}" MinWidth="100" Content="キャンセル" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
