<Window x:Class="FolderDeck.Views.NameInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FolderDeck" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Surface}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource Font.UI}" FontSize="13" UseLayoutRounding="True">
    <!-- Themed name input (登録ペインの登録・名前の変更): the look of ConfirmDialog with a text box. -->
    <StackPanel Margin="22,18,22,16" Width="420">
        <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10" />
        <TextBlock x:Name="BodyText" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,6" />
        <TextBox x:Name="NameBox" Style="{StaticResource Input}" TextChanged="OnTextChanged"
                 AutomationProperties.LabeledBy="{Binding ElementName=BodyText}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="OkButton" Style="{StaticResource Btn.Primary}" MinWidth="110" Margin="0,0,8,0" Content="OK"
                    IsDefault="True" Click="OnOk" />
            <Button Style="{StaticResource Btn}" MinWidth="100" Content="キャンセル" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
