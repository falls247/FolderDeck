<UserControl x:Class="FolderDeck.Views.SidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FolderDeck.ViewModels"
             Focusable="False" Background="Transparent">
    <!-- The sidebar: collapsible sections, each a header and its rows.
         クイック アクセス: 最近の履歴 / よく使う項目 (a click opens or shows that tab).
         登録フォルダ: one row per folder (name only). Resting on a row opens the cascade beside it,
         a click opens the folder in a new tab, a drag moves the row (or hands the folder to another app).
         PC: one row per drive; the same hover and click, no drag; right-click on the header: エクスプローラーで開く. -->
    <UserControl.Resources>
        <!-- Header of a section (DataContext: SidebarSectionViewModel). The whole header folds or
             unfolds the section; Tag is an optional text after the title (a count). -->
        <Style x:Key="SectionHeader" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="30" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Command" Value="{Binding ToggleCommand}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
            <Setter Property="ToolTip" Value="クリックで折りたたむ / 開く" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="900" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" CornerRadius="6" Padding="4,0,6,0" Background="Transparent">
                            <DockPanel>
                                <!-- points down while the section is open, right while it is folded -->
                                <TextBlock x:Name="Chevron" DockPanel.Dock="Left" Text="&#xE70D;" FontFamily="{StaticResource Font.Icons}" FontSize="9"
                                           Width="16" TextAlignment="Center" VerticalAlignment="Center" Margin="0,1,2,0"
                                           Foreground="{DynamicResource Brush.Muted}" RenderTransformOrigin="0.5,0.5" />
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Text="{TemplateBinding Tag}" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="Normal"
                                           Foreground="{DynamicResource Brush.Muted}" Typography.NumeralAlignment="Tabular" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Surface3}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                <Setter TargetName="Chevron" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="-90" />
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Row of クイック アクセス (DataContext: the fixed tab it opens; Tag: the icon glyph).
             Filled while that tab is the shown one, a dot while it is on the tab strip. -->
        <Style x:Key="QuickRow" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="30" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" CornerRadius="6" Padding="8,0,6,0" Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource Font.Icons}" FontSize="14"
                                           VerticalAlignment="Center" Foreground="{DynamicResource Brush.Accent}" />
                                <TextBlock x:Name="NameText" Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <Ellipse x:Name="Dot" Grid.Column="2" Width="6" Height="6" Margin="6,0,4,0" VerticalAlignment="Center"
                                         Fill="{DynamicResource Brush.Accent}" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Surface3}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                                <Setter TargetName="NameText" Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A row of 登録フォルダ or of PC (a drive): icon and name; a warning mark while it cannot be opened. -->
        <DataTemplate x:Key="SidebarRow" DataType="{x:Type vm:SidebarItemViewModel}">
            <Border x:Name="Row" Height="30" CornerRadius="6" Padding="8,0,6,0" Background="Transparent" Cursor="Hand"
                    ToolTip="{Binding ToolTipText}" ToolTipService.InitialShowDelay="900" ToolTipService.Placement="Mouse"
                    MouseEnter="OnRowEnter" MouseLeave="OnRowLeave" MouseMove="OnRowMove"
                    MouseLeftButtonDown="OnRowLeftDown" MouseLeftButtonUp="OnRowLeftUp"
                    MouseRightButtonUp="OnRowRightUp">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Source="{Binding Icon}" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <!-- a drive row has no shell icon: a glyph for its kind (Glyph is null for a 登録フォルダ) -->
                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Font.Icons}" FontSize="14" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Muted}" />
                    <TextBlock x:Name="NameText" Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="Warn" Grid.Column="2" Text="&#xE7BA;" FontFamily="{StaticResource Font.Icons}" FontSize="12"
                               Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Warn}"
                               Visibility="Collapsed" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.Surface3}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsHoverHeld}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.FolderSoft}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                    <Setter TargetName="Warn" Property="Visibility" Value="Visible" />
                    <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource Brush.Muted}" />
                    <Setter TargetName="NameText" Property="TextDecorations" Value="Strikethrough" />
                    <Setter TargetName="Row" Property="Cursor" Value="Arrow" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDragged}" Value="True">
                    <Setter TargetName="Row" Property="Opacity" Value="0.4" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- クイック アクセス: header, rows -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <!-- 登録フォルダ: header, rows (the heights of the body rows and the filler are set in ApplyRowHeights) -->
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="RegisteredBodyRow" Height="*" />
            <!-- PC: header, rows (as high as the drives need, up to a share of the sidebar: ApplyRowHeights) -->
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="PcBodyRow" Height="Auto" />
            <!-- takes the rest while no section does -->
            <RowDefinition x:Name="FillerRow" Height="0" />
        </Grid.RowDefinitions>

        <Button Grid.Row="0" Margin="6,6,6,0" Style="{StaticResource SectionHeader}" DataContext="{Binding QuickSection}" />
        <StackPanel Grid.Row="1" Margin="6,2,6,4" Visibility="{Binding QuickSection.IsExpanded, Converter={StaticResource BoolToVis}}">
            <Button Style="{StaticResource QuickRow}" DataContext="{Binding RecentTab}" Tag="&#xE81C;"
                    CommandParameter="{x:Static vm:TabKind.Recent}"
                    Command="{Binding DataContext.OpenQuickTabCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
            <Button Style="{StaticResource QuickRow}" DataContext="{Binding FrequentTab}" Tag="&#xE734;"
                    CommandParameter="{x:Static vm:TabKind.Frequent}"
                    Command="{Binding DataContext.OpenQuickTabCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
        </StackPanel>

        <DockPanel Grid.Row="2" Margin="6,2,6,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="30" Height="28" FontSize="14" Content="&#xE8F4;" Margin="2,0,0,0"
                    ToolTip="フォルダを選んで登録…（エクスプローラーからフォルダをドロップしても登録できます）" Command="{Binding BrowseCommand}" />
            <Button Style="{StaticResource SectionHeader}" DataContext="{Binding RegisteredSection}" Foreground="{DynamicResource Brush.Folder}"
                    Tag="{Binding DataContext.RegisteredCountText, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
        </DockPanel>

        <!-- The rows of 登録フォルダ. A dragged row is dropped here only (the line shows where it lands). -->
        <Grid x:Name="RegisteredBody" Grid.Row="3" Background="Transparent" AllowDrop="True"
              Visibility="{Binding RegisteredSection.IsExpanded, Converter={StaticResource BoolToVis}}">
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <ItemsControl x:Name="Rows" ItemsSource="{Binding Registered}" ItemTemplate="{StaticResource SidebarRow}"
                              Focusable="False" Margin="6,2,6,8" />
            </ScrollViewer>

            <TextBlock Margin="14,6,12,0" VerticalAlignment="Top" TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource Brush.Muted}" IsHitTestVisible="False"
                       Text="登録フォルダはまだありません。見出しの右のボタンでフォルダを選ぶか、エクスプローラーからフォルダをドロップして追加してください。"
                       Visibility="{Binding HasNoRegistered, Converter={StaticResource BoolToVis}}" />

            <!-- where a dragged row lands -->
            <Border x:Name="DropLine" Height="2" CornerRadius="1" Margin="8,0" VerticalAlignment="Top" Background="{DynamicResource Brush.Accent}"
                    Visibility="Collapsed" IsHitTestVisible="False" />
        </Grid>

        <Button Grid.Row="4" Margin="6,2,6,0" Style="{StaticResource SectionHeader}" DataContext="{Binding PcSection}"
                MouseRightButtonUp="OnPcHeaderRightUp" ToolTip="クリックで折りたたむ / 開く（右クリックでエクスプローラーで開く）" />

        <!-- The drives. Not a drop target: a dragged 登録フォルダ row is refused here (the window's OnDragOver). -->
        <ScrollViewer x:Name="PcScroller" Grid.Row="5" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                      Visibility="{Binding PcSection.IsExpanded, Converter={StaticResource BoolToVis}}">
            <ItemsControl ItemsSource="{Binding DriveList.Drives}" ItemTemplate="{StaticResource SidebarRow}" Focusable="False" Margin="6,2,6,8" />
        </ScrollViewer>
    </Grid>
</UserControl>
