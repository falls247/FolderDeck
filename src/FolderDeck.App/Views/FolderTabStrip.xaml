<UserControl x:Class="FolderDeck.Views.FolderTabStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FolderDeck.Views"
             xmlns:vm="clr-namespace:FolderDeck.ViewModels"
             Focusable="False">
    <!-- The tab strip: every open tab, of any kind. Like Explorer's tabs: click to show, × or middle
         click to close, drag to move. 最近の履歴 / よく使う項目 carry their own icon and the accent
         colour (Brush.Accent); folder tabs the folder colour (Brush.Folder). -->
    <UserControl.Resources>
        <!-- ◀ / ▶ of the strip (like Excel's sheet tabs): repeats while held -->
        <Style x:Key="Btn.TabScroll" TargetType="{x:Type RepeatButton}">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Icons}" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Delay" Value="350" />
            <Setter Property="Interval" Value="120" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Surface3}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <DockPanel>
    <!-- Shown only while the tabs do not fit (UpdateArrows). No scroll bar: the wheel (vertical or horizontal) scrolls too. -->
    <StackPanel x:Name="Arrows" DockPanel.Dock="Left" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,4,0">
        <RepeatButton x:Name="LeftArrow" Style="{StaticResource Btn.TabScroll}" Content="&#xEDD9;" ToolTip="左のタブを表示" />
        <RepeatButton x:Name="RightArrow" Style="{StaticResource Btn.TabScroll}" Content="&#xEDDA;" ToolTip="右のタブを表示" />
    </StackPanel>
    <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False">
        <ItemsControl x:Name="Tabs" ItemsSource="{Binding Tabs}" Focusable="False" Background="Transparent">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:TabViewModel}">
                    <Grid x:Name="Tab" Height="38" MinWidth="76" MaxWidth="200" Margin="0,0,2,0" Background="Transparent" Cursor="Hand"
                          ToolTip="{Binding ToolTipText}" ToolTipService.InitialShowDelay="700"
                          MouseEnter="OnTabEnter" MouseMove="OnTabMove" MouseLeave="OnTabLeave">
                        <Border x:Name="Chip" Margin="0,5,0,5" CornerRadius="7" Background="Transparent" />
                        <DockPanel Margin="10,0,4,0">
                            <!-- ToolTip from the triggers below: Ctrl + W closes only the shown tab, so only its × names it -->
                            <Button x:Name="CloseButton" DockPanel.Dock="Right" Style="{StaticResource Btn.TabClose}"
                                    Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    CommandParameter="{Binding}" />
                            <TextBlock x:Name="Glyph" DockPanel.Dock="Left" Text="&#xE8B7;" FontFamily="{StaticResource Font.Icons}" FontSize="13"
                                       VerticalAlignment="Center" Margin="0,0,7,0" Foreground="{DynamicResource Brush.Folder}" />
                            <TextBlock x:Name="TitleText" Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource Brush.Muted}" />
                        </DockPanel>
                        <Border x:Name="Line" Height="3" VerticalAlignment="Bottom" CornerRadius="2" Margin="8,0"
                                Background="{DynamicResource Brush.Folder}" Visibility="Hidden" />
                    </Grid>
                    <DataTemplate.Triggers>
                        <!-- fixed tabs: their icon, the accent colour -->
                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:TabKind.Recent}">
                            <Setter TargetName="Glyph" Property="Text" Value="&#xE81C;" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Line" Property="Background" Value="{DynamicResource Brush.Accent}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:TabKind.Frequent}">
                            <Setter TargetName="Glyph" Property="Text" Value="&#xE734;" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Line" Property="Background" Value="{DynamicResource Brush.Accent}" />
                        </DataTrigger>
                        <Trigger SourceName="Tab" Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Brush.Surface3}" />
                            <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource Brush.Text}" />
                        </Trigger>
                        <!-- the list under a tab that is not shown is open: highlighted as under the pointer, no tooltip over the list -->
                        <DataTrigger Binding="{Binding IsHoverHeld}" Value="True">
                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Brush.Surface3}" />
                            <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource Brush.Text}" />
                            <Setter TargetName="Tab" Property="ToolTipService.IsEnabled" Value="False" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSelected}" Value="False">
                            <Setter TargetName="CloseButton" Property="ToolTip" Value="タブを閉じる（中クリックでも閉じます）" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="CloseButton" Property="ToolTip" Value="{views:ShortcutTip Text=タブを閉じる, Id=CloseTab, Tail=。中クリックでも閉じます}" />
                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Brush.FolderSoft}" />
                            <Setter TargetName="Line" Property="Visibility" Value="Visible" />
                            <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource Brush.Text}" />
                            <Setter TargetName="TitleText" Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                        <!-- after the trigger above: a selected fixed tab is filled with the accent colour -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsSelected}" Value="True" />
                                <Condition Binding="{Binding IsFolderTab}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                        </MultiDataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
    </DockPanel>
</UserControl>
