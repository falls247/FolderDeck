<UserControl x:Class="FolderDeck.Views.FlyoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FolderDeck.Views"
             Focusable="False" Background="Transparent" Opacity="0"
             FontFamily="{StaticResource Font.UI}">
    <!--
      Level 2+ of the cascade (§9.3), hosted in a Popup. The outer margin leaves room for the
      shadow; FlyoutView.ShadowMargin must match it.
    -->
    <Grid Margin="16" Width="280">
    <!-- the shadow sits on its own layer so scrolling the list never re-renders an effect -->
    <Border CornerRadius="10" Background="{StaticResource Flyout.Bg}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="6" Direction="270" Opacity="0.35" Color="Black" />
        </Border.Effect>
    </Border>
    <Border x:Name="Card" CornerRadius="10" Padding="10"
            Background="{StaticResource Flyout.Bg}" BorderBrush="{StaticResource Flyout.Border}" BorderThickness="1"
            TextElement.Foreground="{StaticResource Overlay.Text}">
        <DockPanel>
            <TextBlock x:Name="Header" DockPanel.Dock="Top" Text="{Binding Title}" FontSize="12.5" FontWeight="Bold"
                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="51" LineHeight="17"
                       LineStackingStrategy="BlockLineHeight" Cursor="Hand" ToolTip="{Binding ToolTipText}"
                       Margin="2,0,2,4">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="TextDecorations" Value="Underline" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,0,2,6"
                        TextElement.Foreground="{StaticResource Overlay.Muted}"
                        Visibility="{Binding CountsKnown, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal" Margin="0,0,12,0" Visibility="{Binding ShowFolderCount, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource Font.Icons}" FontSize="11" Margin="0,1,4,0" />
                    <TextBlock Text="{Binding FolderCount, StringFormat=N0}" FontSize="11" FontWeight="Bold" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding ShowFileCount, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource Font.Icons}" FontSize="11" Margin="0,1,4,0" />
                    <TextBlock Text="{Binding FileCount, StringFormat=N0}" FontSize="11" FontWeight="Bold" />
                </StackPanel>
            </StackPanel>
            <views:EntryListView x:Name="Rows" />
        </DockPanel>
    </Border>
    </Grid>
</UserControl>
