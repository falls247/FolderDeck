<UserControl x:Class="FolderDeck.Views.PreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:FolderDeck.Core.Listing;assembly=FolderDeck.Core"
             Focusable="False" Background="Transparent" Opacity="0"
             FontFamily="{StaticResource Font.UI}">
    <!--
      Preview of a file row, hosted in a Popup beside the list like a flyout: a picture (image,
      shell thumbnail, embedded cover), the first lines of a text file / Word document, or the
      first cells of a sheet. Same frame as FlyoutView; the outer margin is PreviewView.ShadowMargin.
    -->
    <Grid Margin="16" Width="320">
        <Border CornerRadius="10" Background="{StaticResource Flyout.Bg}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="6" Direction="270" Opacity="0.35" Color="Black" />
            </Border.Effect>
        </Border>
        <Border x:Name="Card" CornerRadius="10" Padding="10" Cursor="Hand"
                Background="{StaticResource Flyout.Bg}" BorderBrush="{StaticResource Flyout.Border}" BorderThickness="1"
                TextElement.Foreground="{StaticResource Overlay.Text}"
                ToolTip="{Binding ToolTipText}" ToolTipService.InitialShowDelay="900" ToolTipService.Placement="Mouse">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" FontSize="12.5" FontWeight="Bold"
                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34" LineHeight="17"
                           LineStackingStrategy="BlockLineHeight" Margin="2,0,2,2" />
                <TextBlock DockPanel.Dock="Top" Text="{Binding InfoText}" FontSize="11" Foreground="{StaticResource Overlay.Muted}"
                           TextTrimming="CharacterEllipsis" Margin="2,0,2,8" />

                <!-- shown when the file goes on past the excerpt, or the excerpt is taller than the card -->
                <TextBlock DockPanel.Dock="Bottom" Text="（以下省略）" FontSize="11" Foreground="{StaticResource Overlay.Muted}" Margin="2,6,2,0">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTruncated}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsOverflowing, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ShowDocument}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Grid>
                    <Image x:Name="Picture" Source="{Binding Image}" Stretch="Uniform" StretchDirection="DownOnly"
                           MaxHeight="420" HorizontalAlignment="Center" VerticalAlignment="Top"
                           RenderOptions.BitmapScalingMode="HighQuality" />

                    <!-- text / table: clipped to the card, never scrolled -->
                    <ScrollViewer x:Name="Document" MaxHeight="420" Focusable="False" CanContentScroll="False"
                                  VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding ShowDocument, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="2,0,2,0">
                            <TextBlock Text="{Binding Caption}" FontSize="11" Foreground="{StaticResource Overlay.Muted}"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,0,4"
                                       Visibility="{Binding ShowCaption, Converter={StaticResource BoolToVis}}" />

                            <!-- text file: monospace, one line each -->
                            <Border BorderBrush="{StaticResource Overlay.Divider}" BorderThickness="1" CornerRadius="4" Padding="6,4">
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Lines}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <ItemsControl ItemsSource="{Binding Lines}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontFamily="{StaticResource Font.Mono}" FontSize="11.5"
                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <!-- Word document: wrapped paragraphs, headings bold -->
                            <ItemsControl ItemsSource="{Binding Paragraphs}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type core:WordParagraph}">
                                        <TextBlock x:Name="ParagraphText" Text="{Binding Text}" FontSize="11.5" TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis" Margin="0,0,0,4" />
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsHeading}" Value="True">
                                                <Setter TargetName="ParagraphText" Property="FontWeight" Value="Bold" />
                                                <Setter TargetName="ParagraphText" Property="FontSize" Value="12.5" />
                                                <Setter TargetName="ParagraphText" Property="Margin" Value="0,2,0,4" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Text}" Value="">
                                                <Setter TargetName="ParagraphText" Property="Height" Value="4" />
                                                <Setter TargetName="ParagraphText" Property="Margin" Value="0" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- sheet: cells are built in code (PreviewView.BuildTable) -->
                            <Border x:Name="TableFrame" HorizontalAlignment="Left" BorderBrush="{StaticResource Overlay.Divider}"
                                    BorderThickness="1,1,0,0" Visibility="Collapsed">
                                <Grid x:Name="Table" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Orientation="Horizontal" Margin="2,4,2,6" MinHeight="40"
                                Visibility="{Binding ShowStatus, Converter={StaticResource BoolToVis}}">
                        <ContentControl Style="{StaticResource Spinner}" Width="14" Height="14" Margin="0,0,8,0" Foreground="{StaticResource Overlay.Muted}"
                                        VerticalAlignment="Top" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource Overlay.Muted}" VerticalAlignment="Top" />
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
